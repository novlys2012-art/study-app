# Copy to .env (never commit it). Only scripts and the server function read these, never the app.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# In a Claude Code cloud environment, where ANTHROPIC_API_KEY is reserved, use this name instead
STUDY_APP_ANTHROPIC_KEY=
# For AI_PROVIDER=google: set the key and both model ids
GEMINI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_STRONG=
